AuthType Basic
AuthName "Webcam Admin"
AuthUserFile /etc/apache2/webcam-admin.htpasswd
Require valid-user

<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico)$">
  Satisfy Any
  Allow from all
  AuthType None
  Require all granted
</FilesMatch>

# Rewrites and header forward
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RequestHeader set X-Admin-Token "expr=%{ENV:WEBCAM_ADMIN_API_TOKEN}"

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^api/(.*)$ api.php/$1 [L,NC,QSA]
RewriteRule ^api.php/(.*)$ api.php/$1 [L,NC,QSA]
