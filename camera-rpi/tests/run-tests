if manual_request server-two >/dev/null 2>&1; then fail 'Doppelklick akzeptiert'; fi
if manual_request ../server-two >/dev/null 2>&1; then fail 'Pfadmanipulation akzeptiert'; fi
if manual_request missing >/dev/null 2>&1; then fail 'Unbekanntes Ziel akzeptiert'; fi
