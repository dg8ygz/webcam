#!/usr/bin/env bash
# Real config parser and HTTP argument builders, no camera/network/real keys.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
STAGE="$(mktemp -d)"
trap 'rm -rf -- "$STAGE"' EXIT
source "$ROOT/scripts/lib/camera-rpi-common.sh"
cr_private_file() { [[ -r "$1" ]]; }
printf 'dummy-key\n' > "$STAGE/key"
for value in 2 30 300 700 900 1 901; do
  printf 'server_id=test\nserver_base_url=https://example.invalid/webcam\ncamera_slug=test\nkey_file=%s\ncommand_timeout_seconds=%s\n' \
    "$STAGE/key" "$value" > "$STAGE/test.conf"
  if [[ "$value" == 1 || "$value" == 901 ]]; then
    if cr_load_server_config "$STAGE/test.conf" >/dev/null 2>&1; then exit 1; fi
  else
    cr_load_server_config "$STAGE/test.conf"
    [[ "$COMMAND_TIMEOUT_SECONDS" == "$value" ]]
  fi
done
source <(sed -n '/^poll_command()/,/^parse_command()/p' "$ROOT/scripts/camera-rpi-worker" | sed '$d')
source <(sed -n '/^chunk_upload_is_supported()/,/^upload_legacy_transfer()/p' "$ROOT/scripts/camera-rpi-worker" | sed '$d')
cr_read_secret() { CR_SECRET=dummy-key; }
cr_write_header_file() { printf 'X-Test: dummy\n' > "$3"; }
curl_common_arguments() { CURL_ARGUMENTS=(--connect-timeout 10); }
chunk_response_is_ok() { return 0; }
read_upload_mode() { return 0; }
fake_curl() { printf '%s\n' "$@" > "$STAGE/arguments"; printf '200'; }
PRIVACY_HELPER="$STAGE/no-privacy-helper.php"
CURL_BIN=fake_curl
COMMAND_HEADER_FILE="$STAGE/header"
COMMAND_FORM_FILE="$STAGE/form"
COMMAND_RESPONSE_FILE="$STAGE/response"
COMMAND_RESPONSE_HEADERS="$STAGE/headers"
COMMAND_URL=https://example.invalid/webcam/include/command.php
UPLOAD_HEADER_FILE="$STAGE/header"
UPLOAD_FORM_FILE="$STAGE/form"
UPLOAD_RESPONSE_FILE="$STAGE/response"
CHUNK_UPLOAD_URL=https://example.invalid/webcam/include/upload-chunk.php
COMMAND_TIMEOUT_SECONDS=700
poll_command
[[ "$(sed -n '/^--max-time$/{n;p;}' "$STAGE/arguments")" == 700 ]]
chunk_upload_is_supported
[[ "$(sed -n '/^--max-time$/{n;p;}' "$STAGE/arguments")" == 30 ]]
COMMAND_TIMEOUT_SECONDS=4
chunk_upload_is_supported
[[ "$(sed -n '/^--max-time$/{n;p;}' "$STAGE/arguments")" == 4 ]]
echo 'OK: config 2..900; command 700s, capabilities capped at 30s, connect 10s.'
