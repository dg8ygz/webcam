#!/usr/bin/env bash
# Actual worker/pool/guard integration with synthetic JPEG and HTTP fixtures.
# No live keys, services, remount, camera, GPIO or deployment.
set -euo pipefail
PROJECT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
STAGE="$(mktemp -d /dev/shm/camera-privacy-worker.XXXXXXXX)"
trap 'rm -rf -- "$STAGE"' EXIT
umask 077
mkdir -p "$STAGE/etc/servers" "$STAGE/run" "$STAGE/spool" "$STAGE/status" "$STAGE/privacy"
export CAMERA_RPI_COMMON_LIB="$PROJECT/scripts/lib/camera-rpi-common.sh"
export CAMERA_RPI_POOL_CONFIG="$STAGE/etc/capture-pool.conf" CAMERA_RPI_CONFIG_DIR="$STAGE/etc/servers"
export CAMERA_RPI_OPERATION_LOCK="$STAGE/operation.lock" CAMERA_RPI_STATUS_ROOT="$STAGE/status" CAMERA_RPI_STATUS_GROUP=''
export CAMERA_RPI_PRIVACY_CONFIG="$STAGE/privacy.json" CAMERA_RPI_PRIVACY_RUNTIME="$STAGE/privacy"
export CAMERA_RPI_PRIVACY_HELPER="$PROJECT/scripts/camera-rpi-privacy.php"
export CAMERA_RPI_CLIMATE_CONFIG="$STAGE/no-climate"
export CAMERA_RPI_GPHOTO_BIN="$PROJECT/tests/fixtures/privacy-camera.php" PRIVACY_CAMERA_LOG="$STAGE/camera.log"
export CAMERA_RPI_CURL_BIN="$PROJECT/tests/fixtures/fake-curl" FAKE_UPLOAD_LOG="$STAGE/upload.log"
export FAKE_CURL_ARGUMENT_LOG="$STAGE/curl.log"
export CAMERA_RPI_ALLOW_NONROOT_CONFIG=1
export FAKE_CAPTURE_SERIAL="$(date +%s)"
printf 'source_server=one\n' > "$CAMERA_RPI_POOL_CONFIG"
for id in one two; do
  secret=111111; [[ "$id" != two ]] || secret=222222
  printf 'key-%s-%s\n' "$id" "$secret" > "$STAGE/$id.key"
  printf 'server_id=%s\nserver_base_url=http://server-%s.invalid/webcam\ncamera_slug=test\nkey_file=%s/%s.key\nspool_root=%s/spool\nruntime_root=%s/run\nmanage_root_mount=false\ngphoto_capture_mode=standard\n' \
    "$id" "$id" "$STAGE" "$id" "$STAGE" "$STAGE" > "$STAGE/etc/servers/$id.conf"
done
worker() { bash "$PROJECT/scripts/camera-rpi-worker" --once "$STAGE/etc/servers/$1.conf" > "$STAGE/$1.log" 2>&1 || { cat "$STAGE/$1.log"; return 1; }; }
# A configured closed window consumes the request without touching hardware.
php -r 'require $argv[1]; $c=CapturePrivacy::DEFAULTS; $c["mode"]="fixed"; $c["timezone"]="UTC"; $c["start"]=gmdate("H:i",time()+21600); $c["end"]=gmdate("H:i",time()+25200); file_put_contents(getenv("CAMERA_RPI_PRIVACY_CONFIG"),json_encode(["config"=>$c,"position"=>null]));' "$PROJECT/scripts/lib/capture-privacy.php"
worker one
test ! -s "$PRIVACY_CAMERA_LOG"
test ! -s "$FAKE_UPLOAD_LOG"
test -z "$(find "$STAGE/spool" -name '*.jpg' -o -name '*.request')"
# Pending second peer observed the same generation BEFORE the first poll.
mkdir -p "$STAGE/spool/two/requests"
printf 'capture\npool=0\n' > "$STAGE/spool/two/requests/$FAKE_CAPTURE_SERIAL.request"
worker two
test ! -s "$PRIVACY_CAMERA_LOG"
# Open timing, but require brightness: exactly one shared rejected JPEG.
php -r 'require $argv[1]; $c=CapturePrivacy::DEFAULTS; $c["dark_enabled"]=true; $c["minimum_percent"]=20; file_put_contents(getenv("CAMERA_RPI_PRIVACY_CONFIG"),json_encode(["config"=>$c,"position"=>null]));' "$PROJECT/scripts/lib/capture-privacy.php"
FAKE_CAPTURE_SERIAL=$((FAKE_CAPTURE_SERIAL+1)) worker one
test "$(wc -l < "$PRIVACY_CAMERA_LOG")" = 1
test ! -s "$FAKE_UPLOAD_LOG"
test -z "$(find "$STAGE/spool" -name '*.jpg' -o -name '*.request')"
test -z "$(find "$STAGE/privacy" -name '*.jpg')"
test ! -e "$STAGE/status/latest.jpg"
# A bright generation is published/uploaded for both targets, one physical shot.
PRIVACY_CAMERA_GRAY=200 FAKE_CAPTURE_SERIAL=$((FAKE_CAPTURE_SERIAL+2)) worker one
FAKE_COMMAND_MODE=wait worker two
test "$(wc -l < "$PRIVACY_CAMERA_LOG")" = 2
test -s "$STAGE/status/latest.jpg"
test "$(wc -l < "$FAKE_UPLOAD_LOG")" = 2
printf 'OK: privacy worker/pool closed-window/no USB/dark discard/no upload/bright shared generation; synthetic hardware only\n'
