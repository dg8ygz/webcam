[Unit]
Description=Camera-RPi DHT22 und Geraetestatus
Documentation=file:/usr/local/share/doc/camera-rpi/STATUSSEITE.md
After=systemd-tmpfiles-setup.service
ConditionPathExists=/etc/camera-rpi/device.conf

[Service]
Type=simple
User=root
Group=root
UMask=0027
ExecStart=/usr/local/libexec/camera-rpi-sensor /etc/camera-rpi/device.conf
Restart=on-failure
RestartSec=15s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadWritePaths=/run/camera-rpi-status

[Install]
WantedBy=multi-user.target
