[Unit]
Description=Camera supply with admin ON/OFF and bounded capture recovery
Requires=camera-rpi-gpio.service
After=camera-rpi-gpio.service
ConditionPathExists=/etc/camera-rpi/gpio.json

[Service]
Type=simple
RuntimeDirectory=camera-rpi-power
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/php /usr/local/libexec/camera-rpi-gpio.php power
ExecStartPost=/usr/bin/php /usr/local/libexec/camera-rpi-gpio.php ready-power
TimeoutStartSec=15s
Restart=no
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
